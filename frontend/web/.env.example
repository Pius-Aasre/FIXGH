# ==============================================================================
# FixGH Web Dashboard - Environment Variables
# ==============================================================================
# Copy this file to `.env` and fill in your values.
# All VITE_* variables are injected into the browser bundle at build time.
# ==============================================================================

# URL of the FixGH backend API (the Express server, not the AI service).
#
# Local development: leave this unset and the app automatically targets
# http://<your-hostname>:3000, which works for both localhost and LAN IPs.
#
# Production (Vercel): point it at the deployed backend, e.g.
#   VITE_API_URL=https://fixgh-1.onrender.com
#
# VITE_API_URL=https://fixgh-1.onrender.com
