{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "ai-service": {
      "root": "ai-service",
      "framework": "fastapi"
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "bindings": [
        {
          "type": "service",
          "service": "ai-service",
          "format": "url",
          "env": "AI_SERVICE_URL"
        }
      ]
    },
    "web-app": {
      "root": "web-app",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web-app"
      }
    }
  ]
}
