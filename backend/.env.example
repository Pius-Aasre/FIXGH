# ==============================================================================
# FixGH Backend Environment Configuration (.env)
# ==============================================================================
# INSTRUCTIONS:
# 1. Duplicate this file and rename it to `.env` in the `backend/` folder:
#    cp .env.example .env
# 2. Fill in your real configuration values below.
# 3. NEVER commit your `.env` file to Git / version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 2. DATABASE (Supabase PostgreSQL via Prisma)
# ------------------------------------------------------------------------------
# Find these in: Supabase → Project → Settings → Database → Connection string
#
# Use the "Session mode" URI (port 5432) for DATABASE_URL — works with PgBouncer.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Use the "Direct connection" URI for DIRECT_URL — required for Prisma migrations.
# This bypasses PgBouncer, needed during `prisma migrate deploy`.
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Minimum 32-character secret key used to cryptographically sign JSON Web Tokens.
# Generate a secure random key using PowerShell / Terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string

# ------------------------------------------------------------------------------
# 4. CLOUDINARY (Media & Photo Storage for Citizen Incident Reports)
# ------------------------------------------------------------------------------
# Get your free credentials from: https://cloudinary.com (Dashboard -> API Keys)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ------------------------------------------------------------------------------
# 5. AI CLASSIFICATION & PRIORITY SCORING SERVICE
# ------------------------------------------------------------------------------
# URL of the FastAPI AI microservice (runs from ai-service/main.py)
AI_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 6. RESEND EMAIL (Authority Alerts & Incident Notifications)
# ------------------------------------------------------------------------------
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Sender address:
# - For testing/dev: use Resend's default free verified sender:
#   FixGH Alerts <onboarding@resend.dev>
# - In production (after verifying your custom domain in Resend):
#   FixGH Alerts <alerts@yourdomain.com>
EMAIL_FROM=FixGH Alerts <onboarding@resend.dev>

# TEST MODE — set this to redirect EVERY outbound email (emergency authority
# alerts AND all 40 monthly digests) to a single inbox of your choice.
#
# This is REQUIRED while sending from `onboarding@resend.dev`: Resend only
# permits that test sender to deliver to the account owner's own email address
# and rejects every other recipient with HTTP 403 "You can only send testing
# emails to your own email address".
#
# The authority each alert was really addressed to is preserved in the subject
# prefix ([TEST → info@ama.gov.gh]) and in a banner at the top of the email.
# Leave empty to deliver to the real recipients.
EMAIL_TEST_RECIPIENT=your_test_inbox@example.com

# Authority Web Dashboard base URL inserted into alert emails
DASHBOARD_URL=https://fixgh-dashboard.vercel.app
